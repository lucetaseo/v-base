{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm install --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/rpc.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!api/|assets/|templates/).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(kakaotalk-scrap|facebookexternalhit|twitterbot|slackbot|discordbot|telegrambot|whatsapp|line-poker|yeti|daum|bingbot|googlebot).*"
        }
      ],
      "destination": "/api/page?path=/:path"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/rpc",
      "schedule": "7 18 * * *"
    }
  ]
}
