# ============================================================
# 서버 환경변수 예시 — 이 파일을 복사해 .env 로 만들고 값을 채우세요.
# .env 는 git 에 올라가지 않습니다. (Vercel 에는 Settings > Environment Variables 에 입력)
# ============================================================

# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (포트 6543)
DATABASE_URL=postgresql://postgres.xxxx:[비밀번호]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 로그인 쿠키 서명용 비밀값 (32자 이상 무작위 문자열)
#   만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 최초 운영자 계정 (npm run db:setup 때만 사용)
INIT_SUPER_LOGIN=
INIT_SUPER_PASSWORD=

# (선택) 전자서명 링크의 기본 주소. 비우면 접속한 주소를 사용
# PUBLIC_BASE_URL=https://uffice.co.kr/

# (선택) Supabase CA 인증서(PEM) — 넣으면 DB 서버 인증서까지 검증
# DATABASE_CA_CERT=

# 화면을 서버 모드로 빌드 (없으면 데모 모드)
VITE_API_MODE=server

# (개발용) 자동 시험 전용 DB — 시험 때 표를 지웠다 다시 만듭니다. 실서비스 DB 주소 금지
# TEST_DATABASE_URL=postgresql://postgres:비밀번호@localhost:5432/uffice_test
